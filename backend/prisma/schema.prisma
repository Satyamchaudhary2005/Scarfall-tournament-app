generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  username                String                   @unique
  email                   String                   @unique
  passwordHash            String?
  avatarUrl               String?
  bannerUrl               String?
  role                    String                   @default("USER")
  googleId                String?                  @unique
  discordId               String?                  @unique
  supabaseId              String?                  @unique
  passwordResetToken      String?
  passwordResetExpires    DateTime?
  points                  Int                      @default(0)
  kills                   Int                      @default(0)
  deaths                  Int                      @default(0)
  matchesPlayed           Int                      @default(0)
  wins                    Int                      @default(0)
  clanId                  String?
  clanRole                String?
  ign                     String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  createdClan             Clan?                    @relation("ClanLeader")
  clanActivityLogs        ClanActivityLog[]
  receivedInvites         ClanInvite[]             @relation("ReceivedInvites")
  sentInvites             ClanInvite[]             @relation("SentInvites")
  joinRequests            ClanJoinRequest[]
  leaderboardEntries      LeaderboardEntry[]
  sentNotifications       Notification[]           @relation("NotificationSender")
  notifications           Notification[]           @relation("NotificationRecipient")
  reportedReports         Report[]                 @relation("ReportReported")
  reports                 Report[]                 @relation("ReportReporter")
  hostedTournaments       Tournament[]             @relation("TournamentHost")
  tournamentRegistrations TournamentRegistration[]
  autoTournamentTemplates AutoTournamentTemplate[]
  clan                    Clan?                    @relation(fields: [clanId], references: [id])
  wallet                  Wallet?

  @@index([clanId])
  @@index([points])
  @@index([email])
}

model Clan {
  id                      String                   @id @default(uuid())
  name                    String                   @unique
  tag                     String                   @unique
  description             String?
  logoUrl                 String?
  bannerUrl               String?
  color                   String                   @default("#ff1f1f")
  points                  Int                      @default(0)
  wins                    Int                      @default(0)
  matchesPlayed           Int                      @default(0)
  rank                    Int                      @default(0)
  maxMembers              Int                      @default(15)
  leaderId                String                   @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  leader                  User                     @relation("ClanLeader", fields: [leaderId], references: [id])
  activityLogs            ClanActivityLog[]
  invites                 ClanInvite[]
  joinRequests            ClanJoinRequest[]
  tournamentRegistrations TournamentRegistration[]
  members                 User[]

  @@index([points])
  @@index([name])
}

model Tournament {
  id                   String                   @id @default(uuid())
  title                String
  description          String?
  bannerUrl            String?
  ign                  String?
  prizePool            String                   @default("0")
  entryFee             String                   @default("Free")
  mode                 String                   @default("SOLO")
  slots                Int                      @default(100)
  status               String                   @default("UPCOMING")
  registrationStartsAt DateTime?
  registrationEndsAt   DateTime?
  startsAt             DateTime
  endsAt               DateTime?
  mapName              String?
  maxTeams             Int?
  minRank              String?
  rules                String?
  roomId               String?
  roomPassword         String?
  hostId               String
  // Battle Royale multi-round format
  format               String                   @default("SINGLE") // SINGLE, MULTI_ROUND, or MULTI_STAGE
  totalRounds          Int                      @default(1)
  killPoints           Int                      @default(1)
  placementPoints      String?                  // JSON array: [15,12,10,8,6,4,2,1,0,0,0,0,0,0,0,0]
  // Multi-Stage Tournament fields
  stageConfig          String?                  // JSON: full stage configuration
  totalRegisteredTeams Int?                     // Total teams registered for multi-stage
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  host                 User                     @relation("TournamentHost", fields: [hostId], references: [id])
  registrations        TournamentRegistration[]
  rounds               Round[]
  stages               TournamentStage[]

  @@index([status])
  @@index([startsAt])
  @@index([hostId])
}

model TournamentStage {
  id                 String          @id @default(uuid())
  tournamentId       String
  stageNumber        Int
  name               String           // e.g. "Open Qualifier", "Semi Finals"
  type               String           // e.g. "OPEN_QUALIFIER", "ROUND_1", "WILDCARD", "SEMI_FINALS", "GRAND_FINALS"
  status             String           @default("PENDING") // PENDING, ACTIVE, COMPLETED
  teamsCount         Int              @default(0)
  qualifyingTeams    Int              @default(0)
  eliminationCount   Int              @default(0)
  lobbyCount         Int              @default(0)
  teamsPerLobby      Int              @default(16)
  matchesCount       Int              @default(0)
  formatType         String           @default("STANDARD") // STANDARD, BATTLE_ROYALE, SWISS, ROUND_ROBIN
  scoringRules       String?          // JSON: per-stage scoring config
  mapRotation        String?          // JSON: map list for this stage
  roomSettings       String?          // JSON: room configuration
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tournament         Tournament       @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, stageNumber])
  @@index([tournamentId])
  matches          StageMatch[]
}

model StageMatch {
  id                 String           @id @default(uuid())
  stageId            String
  tournamentId       String
  matchNumber        Int              // lobby/count number
  name               String           // e.g. "Lobby A", "Match 1"
  status             String           @default("PENDING") // PENDING, LIVE, COMPLETED
  teamsCount         Int              @default(0)
  roomId             String?
  roomPassword       String?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  stage              TournamentStage  @relation(fields: [stageId], references: [id])
  teams              StageMatchTeam[]

  @@unique([stageId, matchNumber])
  @@index([stageId])
  @@index([tournamentId])
}

model StageMatchTeam {
  id             String       @id @default(uuid())
  matchId        String
  teamId         String       // userId for SOLO, clanId for DUO/SQUAD
  teamName       String
  placement      Int          @default(0)
  kills          Int          @default(0)
  points         Int          @default(0)
  eliminated     Boolean      @default(false)
  qualified      Boolean      @default(false)
  confirmed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  match          StageMatch   @relation(fields: [matchId], references: [id])

  @@unique([matchId, teamId])
  @@index([matchId])
}

model Round {
  id           String   @id @default(uuid())
  tournamentId String
  roundNumber  Int
  title        String?
  status       String   @default("UPCOMING") // UPCOMING, WAITING, LIVE, COMPLETED
  startsAt     DateTime?
  roomId       String?
  roomPassword String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  scores       RoundScore[]

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId])
}

model RoundScore {
  id        String @id @default(uuid())
  roundId   String
  teamId    String // userId for SOLO, clanId for DUO/SQUAD
  teamName  String
  placement Int    // 1st, 2nd, 3rd...
  kills     Int    @default(0)
  points    Int    @default(0)
  confirmed Boolean @default(false)
  round     Round  @relation(fields: [roundId], references: [id])

  @@unique([roundId, teamId])
  @@index([roundId])
}

model TournamentRegistration {
  id                String     @id @default(uuid())
  teamName          String?
  teamSize          Int        @default(1)
  clanId            String?
  playingMembers    String?
  substituteMembers String?
  clanXpAwarded     Int        @default(0)
  tournamentId      String
  userId            String?
  guestIgn          String?    // For manual registrations (players without an account)
  status            String     @default("CONFIRMED")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User?      @relation(fields: [userId], references: [id])
  tournament        Tournament @relation(fields: [tournamentId], references: [id])
  clan              Clan?      @relation(fields: [clanId], references: [id])

  @@index([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([clanId])
}

model LeaderboardEntry {
  id            String   @id @default(uuid())
  score         Int      @default(0)
  kills         Int      @default(0)
  deaths        Int      @default(0)
  wins          Int      @default(0)
  matchesPlayed Int      @default(0)
  type          String   @default("GLOBAL")
  season        String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, type, season])
  @@index([type, score])
  @@index([userId])
}

model Notification {
  id          String   @id @default(uuid())
  type        String
  title       String
  message     String
  link        String?
  read        Boolean  @default(false)
  recipientId String
  senderId    String?
  createdAt   DateTime @default(now())
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id])
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

model ClanInvite {
  id        String   @id @default(uuid())
  status    String   @default("PENDING")
  clanId    String
  inviterId String
  inviteeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invitee   User     @relation("ReceivedInvites", fields: [inviteeId], references: [id])
  inviter   User     @relation("SentInvites", fields: [inviterId], references: [id])
  clan      Clan     @relation(fields: [clanId], references: [id])

  @@unique([clanId, inviteeId])
  @@index([inviteeId, status])
  @@index([clanId, status])
}

model ClanJoinRequest {
  id        String   @id @default(uuid())
  status    String   @default("PENDING")
  clanId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  clan      Clan     @relation(fields: [clanId], references: [id])

  @@unique([clanId, userId])
  @@index([clanId, status])
  @@index([userId, status])
}

model ClanActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  clanId    String
  actorId   String
  targetId  String?
  createdAt DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
  clan      Clan     @relation(fields: [clanId], references: [id])

  @@index([clanId, createdAt])
}

model Report {
  id          String   @id @default(uuid())
  reason      String
  description String?
  status      String   @default("PENDING")
  reporterId  String
  reportedId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reported    User     @relation("ReportReported", fields: [reportedId], references: [id])
  reporter    User     @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([status])
  @@index([reportedId])
}

model AutoTournamentTemplate {
  id              String    @id @default(uuid())
  title           String
  description     String?
  bannerUrl       String?
  prizePool       String    @default("0")
  entryFee        String    @default("Free")
  mode            String    @default("SOLO")
  slots           Int       @default(100)
  mapName         String?
  rules           String?
  format          String    @default("SINGLE")
  totalRounds     Int       @default(1)
  killPoints      Int       @default(1)
  placementPoints String?
  isActive        Boolean   @default(true)
  createdBy       String
  lastCreatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator User @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([isActive])
}

model Wallet {
  id        String   @id @default(uuid())
  balance   Float    @default(0)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  type        String   // DEPOSIT, WITHDRAW, TOURNAMENT_FEE, TOURNAMENT_WINNING, CLAN_FEE
  amount      Float
  description String?
  status      String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([walletId, createdAt])
}
